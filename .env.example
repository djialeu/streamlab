# Copier ce fichier en .env (cp .env.example .env) puis adapter si besoin.
# Valeurs de DÉVELOPPEMENT uniquement : aucun secret réel ici.

# --- Ports exposés sur la machine hôte (Docker) ---
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
# 5433 par défaut : 5432 est souvent déjà pris par un PostgreSQL local.
POSTGRES_PORT=5433

# --- PostgreSQL : super-utilisateur (administration seulement) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# --- PostgreSQL : un utilisateur par service, limité à sa propre base ---
CATALOG_DB_PASSWORD=catalog_dev
IDENTITY_DB_PASSWORD=identity_dev
STATS_DB_PASSWORD=stats_dev

# --- Services Python (lancés sur l'hôte avec pnpm dev) ---
# Les services sont sur l'hôte : ils utilisent le listener HOST de Kafka.
KAFKA_BROKERS=localhost:9092
CATALOG_PORT=3001
IDENTITY_PORT=3002
STATS_PORT=3003
